    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "Admin user listing",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["active", "suspended"] },
            "description": "Filter by user status"
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["user", "admin"] },
