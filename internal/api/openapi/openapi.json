          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/admin/auctions": {
      "get": {
        "tags": ["Admin"],
        "summary": "Admin auction listing",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by auction status"
          },
          {
            "name": "seller_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Filter by seller ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Admin auction overview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminListAuctionsResponse"
