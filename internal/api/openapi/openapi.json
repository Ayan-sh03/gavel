{
  "openapi": "3.0.3",
  "info": {
    "title": "Gavel Auction API",
    "description": "Official REST API documentation for the Gavel auction platform. The service provides endpoints for authentication, listings, auctions, bidding, payments, watchlists, admin tooling, and real-time updates.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Service health checks" },
    { "name": "Auth", "description": "Authentication endpoints" },
    { "name": "Users", "description": "Authenticated user profile" },
    { "name": "Listings", "description": "Listing management" },
    { "name": "Auctions", "description": "Auction lifecycle operations" },
    { "name": "Bids", "description": "Bid placement and history" },
    { "name": "Payments", "description": "Buyer payments and payouts" },
    { "name": "Watchlist", "description": "Buyer watchlist management" },
    { "name": "Admin", "description": "Administrative tooling" },
    { "name": "Realtime", "description": "Server-Sent Events streaming" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Read service health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create user",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate and fetch JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get current user profile",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/listings": {
      "post": {
        "tags": ["Listings"],
        "summary": "Create a listing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateListingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Listing created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create listing",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Listings"],
        "summary": "List listings",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter listings by category"
          },
          {
            "name": "seller_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Filter listings by seller ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Listings page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListListingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/listings/{id}": {
      "get": {
        "tags": ["Listings"],
        "summary": "Get listing by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Listing details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Listing not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Listings"],
        "summary": "Update a listing",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateListingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Only the seller may update the listing",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Listing not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/auctions": {
      "post": {
        "tags": ["Auctions"],
        "summary": "Create an auction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuctionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Auction created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuctionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Only the listing owner may create an auction",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Listing not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Auctions"],
        "summary": "List auctions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["scheduled", "live", "ended", "canceled"] },
            "description": "Filter auctions by status"
          }
        ],
        "responses": {
          "200": {
            "description": "Auctions page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAuctionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auctions/{id}": {
      "get": {
        "tags": ["Auctions"],
        "summary": "Get auction by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Auction details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuctionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Auction not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Auctions"],
        "summary": "Update an auction (admin only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuctionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auction update accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Admin role required",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Auction not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/auctions/{id}/cancel": {
      "post": {
        "tags": ["Auctions"],
        "summary": "Cancel an auction (seller)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Auction canceled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Only the seller can cancel before bids",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Auction not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/auctions/{id}/bids": {
      "post": {
        "tags": ["Bids"],
        "summary": "Place a bid",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceBidRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bid accepted",
            "headers": {
              "Location": {
                "description": "Optional location of the created bid record",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceBidResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Sellers may not bid on their own auction",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Auction not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "409": {
            "description": "Bid did not meet the minimum increment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceBidResponse"
                }
              }
            }
          },
          "410": {
            "description": "Auction is no longer live",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Bids"],
        "summary": "List bids for an auction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Bid history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBidsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auctions/{id}/pay": {
      "post": {
        "tags": ["Payments"],
        "summary": "Create winner payment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Auction not finalized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Only the winner may pay",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Auction not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "tags": ["Payments"],
        "summary": "Get payment details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Winner or admin access required",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/auctions/{id}/watch": {
      "post": {
        "tags": ["Watchlist"],
        "summary": "Add auction to watchlist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "201": {
            "description": "Added to watchlist"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "500": {
            "description": "Failed to add to watchlist",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
